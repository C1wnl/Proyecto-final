      "source": [
        "from collections import deque\n",
        "\n",
        "# Grafo del ejercicio\n",
        "grafo = {\n",
        "    'S': ['A', 'D'],\n",
        "    'A': ['B', 'C'],\n",
        "    'D': ['E'],\n",
        "    'B': ['F'],\n",
        "    'C': ['G'],\n",
        "    'E': ['G'],\n",
        "    'F': ['G'],\n",
        "    'G': []\n",
        "}\n",
        "\n",
        "# Búsqueda en amplitud\n",
        "def bfs(grafo, inicio, meta):\n",
        "\n",
        "    cola = deque([[inicio]])\n",
        "    visitados = []\n",
        "\n",
        "    while cola:\n",
        "        camino = cola.popleft()\n",
        "        nodo = camino[-1]\n",
        "\n",
        "        if nodo == meta:\n",
        "            return camino\n",
        "\n",
        "        if nodo not in visitados:\n",
        "            visitados.append(nodo)\n",
        "\n",
        "            for vecino in grafo[nodo]:\n",
        "                nuevo_camino = list(camino)\n",
        "                nuevo_camino.append(vecino)\n",
        "                cola.append(nuevo_camino)\n",
        "\n",
        "\n",
        "# Búsqueda en profundidad\n",
        "def dfs(grafo, nodo, meta, visitados=None):\n",
        "\n",
        "    if visitados is None:\n",
        "        visitados = []\n",
        "\n",
        "    visitados.append(nodo)\n",
        "\n",
        "    if nodo == meta:\n",
        "        return visitados\n",
        "\n",
        "    for vecino in grafo[nodo]:\n",
        "        if vecino not in visitados:\n",
        "            resultado = dfs(grafo, vecino, meta, visitados)\n",
        "            if resultado:\n",
        "                return resultado\n",
        "\n",
        "\n",
        "print(\"Resultado BFS:\", bfs(grafo,'S','G'))\n",
        "print(\"Resultado DFS:\", dfs(grafo,'S','G'))"
      ]
    }
  ]
